# Copy to .env. Compose reads it automatically.

# Required. The database is not reachable from outside the compose network,
# but a real password still keeps the services honest.
POSTGRES_PASSWORD=change-me

# Optional.
POSTGRES_USER=screener
POSTGRES_DB=screener
WEB_PORT=80

# Seconds between captures, during live sessions only (pre-market 04:00 ET
# through after-hours 20:00 ET, trading days only). Keep this at 300 or above:
# TradingView's endpoint is free by courtesy, not by contract.
SCAN_INTERVAL_SECONDS=300

# Times-of-day (ET, comma separated) that are always captured, whatever the
# interval above. Captures otherwise land on a clock-aligned grid -- with 300
# that is :00, :05, :10 -- so a moment like 09:31 is only reachable by pinning
# it. Leave empty for the grid alone.
#   09:31  the first minute of the drive, once the opening auction has printed
#   09:35  the reference Ross Cameron reads
# Pinned in ET on purpose: Paris and New York change clocks on different dates.
SCAN_AT=09:31,09:35

# Store the whole market every Nth capture. 1 keeps everything — about 870 MB a
# day, 215 GB a year. Raising it trades training resolution for disk and leaves
# the board just as fresh, since the board is written on every capture anyway.
#   1 -> 215 GB/yr    3 -> 72 GB/yr    6 -> 36 GB/yr
STORE_MARKET_EVERY=1

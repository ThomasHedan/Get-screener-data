# Copy to .env next to compose.yaml. Compose reads it automatically.

# Hostname the dashboard answers on. A real hostname pointed at this machine
# gets an automatic Let's Encrypt certificate; :80 serves plain HTTP on the
# host's IP, which is fine for a first smoke test and not for anything else.
SCREENER_DOMAIN=:80

# Seconds between scans, during live sessions only (pre-market 04:00 ET through
# after-hours 20:00 ET, trading days only). 300 keeps the board under five
# minutes old at any check.
SCAN_INTERVAL_SECONDS=300
